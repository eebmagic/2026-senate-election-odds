{
  // Cloudflare Worker that serves the static site in web/ (no build step,
  // no server code -- assets only). Deployed by `wrangler deploy` from this
  // repo root, and by the worker's connected-Git build (deploy command:
  // `npx wrangler deploy`). Custom domain (senate-elections.ebolton.site) and
  // DNS are managed in the Cloudflare dashboard, not here.
  "name": "senate-elections",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./web"
  }
}
