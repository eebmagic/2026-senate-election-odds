# Cloudflare R2 credentials for the Senate data pipeline (script.py).
#
# Create an R2 API token in the Cloudflare dashboard:
#   R2  ->  "Manage R2 API Tokens"  ->  Create API token
#   Permission: Object Read & Write, scoped to the election-map bucket.
#
# Then copy this file to .env (gitignored) and fill in the values.

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Bucket that latest.json and snapshots/ are written to.
R2_BUCKET=election-map

# Optional. Public base URL bound to the bucket -- an r2.dev dev domain or a
# custom domain. Only used to print latest.json's public URL after a run;
# leave blank if the bucket isn't publicly exposed.
R2_PUBLIC_BASE_URL=
